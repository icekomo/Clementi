    ></script>

    <link rel="stylesheet" href="css/styles.css" />
    <title>
        Clementi Consulting | FDA Regulatory Affairs Consultants | CDER & CBER
    </title>
    <meta
        name="description"
        content="Clementi Consulting provides expert FDA regulatory affairs, CMC development, and GxP compliance support for pharmaceutical and biotechnology companies navigating CDER and CBER pathways."
    />

    <link rel="canonical" href="https://www.clementiconsulting.com/" />

    <!-- Open Graph -->
    <meta
        property="og:title"
        content="Clementi Consulting | FDA Regulatory Affairs & Medical Consultants"
    />
    <meta
        property="og:description"
        content="Strategic regulatory and medical affairs consulting for pharma and biotech. Deep expertise in FDA submissions, IND/BLA, cell & gene therapy, and GxP compliance."
    />
    <meta
        property="og:image"
        content="https://www.clementiconsulting.com/img/og-preview.jpg"
    />
    <meta property="og:url" content="https://www.clementiconsulting.com/" />
    <meta property="og:type" content="website" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
        name="twitter:title"
        content="Clementi Consulting | FDA Regulatory Affairs & Medical Consultants"
    />
    <meta
        name="twitter:description"
        content="Expert FDA regulatory affairs and medical consulting for pharmaceutical and biotech innovators."
    />
